{
  "article": {
    "type": "object",
    "properties": {
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "minLength": 12,
        "maxLength": 100
      },
      "title": {
        "type": "string",
        "minLength": 25,
        "maxLength": 85
      },
      "description": {
        "type": "string",
        "minLength": 90,
        "maxLength": 180
      },
      "intro": {
        "type": "string",
        "minLength": 300,
        "maxLength": 1000
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "heading": {
              "type": "string",
              "minLength": 10,
              "maxLength": 140
            },
            "paragraphs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 400,
                "maxLength": 1200
              },
              "minItems": 2,
              "maxItems": 2
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 15,
                "maxLength": 300
              },
              "minItems": 0,
              "maxItems": 4
            },
            "sourceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ranking",
                  "reviews",
                  "reply",
                  "hours",
                  "managers",
                  "photos"
                ]
              },
              "minItems": 1,
              "maxItems": 3
            }
          },
          "required": [
            "heading",
            "paragraphs",
            "items",
            "sourceIds"
          ],
          "additionalProperties": false
        },
        "minItems": 4,
        "maxItems": 4
      },
      "faq": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "minLength": 15,
              "maxLength": 160
            },
            "answer": {
              "type": "string",
              "minLength": 80,
              "maxLength": 500
            }
          },
          "required": [
            "question",
            "answer"
          ],
          "additionalProperties": false
        },
        "minItems": 0,
        "maxItems": 2
      },
      "checklist": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 15,
          "maxLength": 250
        },
        "minItems": 3,
        "maxItems": 5
      },
      "futureTopics": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "keyword": {
              "type": "string",
              "minLength": 20,
              "maxLength": 120
            },
            "angle": {
              "type": "string",
              "minLength": 40,
              "maxLength": 300
            }
          },
          "required": [
            "keyword",
            "angle"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 2
      }
    },
    "required": [
      "slug",
      "title",
      "description",
      "intro",
      "sections",
      "faq",
      "checklist",
      "futureTopics"
    ],
    "additionalProperties": false
  },
  "critic": {
    "type": "object",
    "properties": {
      "approved": {
        "type": "boolean"
      },
      "unsupportedClaims": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        },
        "minItems": 0,
        "maxItems": 10
      },
      "reason": {
        "type": "string",
        "minLength": 15,
        "maxLength": 1200
      }
    },
    "required": [
      "approved",
      "unsupportedClaims",
      "reason"
    ],
    "additionalProperties": false
  }
}
